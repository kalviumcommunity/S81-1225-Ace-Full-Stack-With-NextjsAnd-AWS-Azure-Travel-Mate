# ==============================================================================
# TRAVEL MATE - ENVIRONMENT VARIABLES EXAMPLE
# ==============================================================================
# Copy this file to .env.local and replace placeholder values with real secrets.
# NEVER commit .env.local to version control!
#
# Variable Types:
# - SERVER-ONLY: Only accessible on the server (API routes, server components)
# - CLIENT-SAFE: Exposed to the browser (prefixed with NEXT_PUBLIC_)
# ==============================================================================


# ==============================================================================
# 🔒 DATABASE CONFIGURATION (SERVER-ONLY)
# ==============================================================================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# ⚠️  Contains credentials - NEVER expose to client
DATABASE_URL=postgresql://username:password@localhost:5432/travelmate_db


# ==============================================================================
# 🔒 REDIS CONFIGURATION (SERVER-ONLY)
# ==============================================================================
# Redis connection URL for caching and session management
# Format: redis://HOST:PORT or redis://:PASSWORD@HOST:PORT
REDIS_URL=redis://localhost:6379


# ==============================================================================
# 🔒 JWT AUTHENTICATION (SERVER-ONLY)
# ==============================================================================
# Secret key for signing JWT access tokens
# Generate with: openssl rand -base64 64
# ⚠️  CRITICAL: Change these in production!
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Secret key for signing JWT refresh tokens (separate from access token secret)
# Generate with: openssl rand -base64 64
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production


# ==============================================================================
# 🔒 AWS CONFIGURATION (SERVER-ONLY)
# ==============================================================================
# AWS IAM credentials for S3 and SES services
# Create an IAM user with S3 and SES permissions
# ⚠️  Never share or commit these credentials!

# AWS IAM Access Key ID
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE

# AWS IAM Secret Access Key
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# AWS Region (e.g., us-east-1, ap-south-1, eu-west-1)
AWS_REGION=ap-south-1


# ==============================================================================
# 🔒 AWS S3 CONFIGURATION (SERVER-ONLY)
# ==============================================================================
# S3 bucket for file uploads (profile images, travel photos)
# Bucket must exist and IAM user needs s3:PutObject, s3:GetObject permissions
AWS_BUCKET_NAME=your-s3-bucket-name


# ==============================================================================
# 🔒 AWS SES CONFIGURATION (SERVER-ONLY)
# ==============================================================================
# Verified email address for sending transactional emails
# Must be verified in AWS SES console
# In sandbox mode, recipient emails must also be verified
SES_EMAIL_SENDER=no-reply@yourdomain.com


# ==============================================================================
# 🔒 MAP PROVIDER CONFIGURATION (SERVER-ONLY)
# ==============================================================================
# Map service provider (mapbox, google, etc.)
MAP_PROVIDER=mapbox

# Mapbox API token for map rendering
# Get from: https://account.mapbox.com/access-tokens/
MAPBOX_API_KEY=pk.your-mapbox-public-token


# ==============================================================================
# 🔒 LOGGING CONFIGURATION (SERVER-ONLY)
# ==============================================================================
# Log level: debug, info, warn, error
# Defaults to 'debug' in development, 'info' in production
LOG_LEVEL=info


# ==============================================================================
# 🌐 CLIENT-SIDE VARIABLES (NEXT_PUBLIC_*)
# ==============================================================================
# ⚠️  WARNING: These are exposed to the browser!
# Only include non-sensitive configuration here.

# Base URL for API requests (used by client-side fetch calls)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Environment identifier for debugging and feature flags
# Values: development, staging, production, docker
NEXT_PUBLIC_ENV=development


# ==============================================================================
# 🐳 DOCKER CONFIGURATION (OPTIONAL)
# ==============================================================================
# Uncomment these when running with docker-compose
# These override the above values for containerized environments

# DATABASE_URL=postgresql://postgres:postgres123@db:5432/travelmate_db
# REDIS_URL=redis://redis:6379
# NEXT_PUBLIC_API_URL=http://localhost:3000/api
# NEXT_PUBLIC_ENV=docker


# ==============================================================================
# 📝 NOTES
# ==============================================================================
# 1. All SERVER-ONLY variables are accessed via process.env.VARIABLE_NAME
#    in API routes and server components only.
#
# 2. CLIENT-SAFE variables (NEXT_PUBLIC_*) are inlined at build time
#    and visible in browser JavaScript bundles.
#
# 3. NODE_ENV is automatically set by Next.js:
#    - 'development' when running `next dev`
#    - 'production' when running `next build` and `next start`
#
# 4. For production deployments, set environment variables in:
#    - Vercel: Project Settings → Environment Variables
#    - Docker: docker-compose.yml or docker run -e flags
#    - AWS: Parameter Store, Secrets Manager, or ECS task definitions
# ==============================================================================
