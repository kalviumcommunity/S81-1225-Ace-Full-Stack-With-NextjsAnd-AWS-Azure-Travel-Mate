# Server-side variables (never exposed to the browser)
DATABASE_URL=postgres://username:password@localhost:5432/travelmate_db
REDIS_URL=redis://localhost:6379
MAP_PROVIDER=mapbox
MAPBOX_API_KEY=pk.your-provider-token

# AWS S3 Configuration (for file uploads)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=your-s3-bucket-name

# AWS SES Configuration (for email sending)
# Uses the same AWS credentials as S3 above
# SES_EMAIL_SENDER must be verified in AWS SES
SES_EMAIL_SENDER=no-reply@yourdomain.com

# Client-side variables (must start with NEXT_PUBLIC_)
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_ENV=production

# Docker-specific variables (used in docker-compose.yml)
# DATABASE_URL=postgresql://postgres:postgres123@db:5432/travelmate_db
# REDIS_URL=redis://redis:6379
# NEXT_PUBLIC_API_URL=http://localhost:3000/api
# NEXT_PUBLIC_ENV=docker
